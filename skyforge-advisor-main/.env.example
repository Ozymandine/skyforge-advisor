# Copy to .env (never commit .env). All values optional for local dev.
# Comma-separated Hypixel API keys (UUID shape). Used only as a shared fallback
# when the visitor hasn't supplied their own key (BYOK).
HYPIXEL_API_KEY=

# Cloudflare KV for market history persistence in production.
# When unset, history falls back to local .data/market-store.json (dev) or
# lossy in-memory on read-only serverless.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE=
CF_KV_TOKEN=

# Comma-separated origins allowed to call /api/flips + /api/leaderboard with CORS.
# Empty = same-origin only (no Access-Control-Allow-Origin header).
# Example: PUBLIC_API_ORIGINS=https://skyforge-advisor.vercel.app,https://your-mod.dev
PUBLIC_API_ORIGINS=
